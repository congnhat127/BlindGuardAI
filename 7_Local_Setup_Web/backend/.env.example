# Cau hinh web cai dat tai xe (Tier 1)
# Copy thanh .env va sua theo moi truong. KHONG commit file .env that.

# mock  = khong can camera / GPS, sinh khung hinh tu mo hinh camera (mac dinh khi phat trien)
# jetson = doc camera va GPS that tren xe
BLINDGUARD_DEVICE_BACKEND=mock

# Ma PIN bao ve moi thao tac GHI cau hinh.
# BAT BUOC dat truoc khi giao xe: web chay tren Wi-Fi cua xe, khong co PIN thi
# bat ky ai trong tam phu song deu sua duoc cau hinh an toan cua xe dang chay.
BLINDGUARD_SETUP_PIN=

# Tren xe nen bind dung interface AP thay vi 0.0.0.0
BLINDGUARD_HOST=127.0.0.1
BLINDGUARD_PORT=8080

# Toc do khung luong MJPEG va chat luong JPEG
BLINDGUARD_STREAM_FPS=8
BLINDGUARD_JPEG_QUALITY=82
